{
  "rewrites": [
    {
      "source": "/css/(.*)",
      "destination": "/portfolio/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/portfolio/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/portfolio/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/portfolio/$1"
    }
  ]
}